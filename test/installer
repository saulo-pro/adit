#!/usr/bin/env bash
# Installs adit as a reader of the landing page would, with docs/install.sh, from a release built
# here, then takes it off again with the commands install.sh prints. On the way it checks that the
# installer refuses a download whose checksum does not match, and a Mac where Homebrew installed adit.
# It installs for real, in /usr/local/bin, so it runs where sudo asks for no password: CI's root job
# and test/vm's machine.
set -euo pipefail
cd "$(dirname "$0")/.."
source test/lib.sh

label=pro.saulo.adit
bin=/usr/local/bin
version=0.0.0-installer
sudo -n true 2> /dev/null || fail "sudo asks for a password here; this runs only where it does not"
if [[ -e /Library/LaunchDaemons/$label.plist || -e $bin/adit ]]; then
  fail "adit is already installed here, and this test would replace it"
fi

work=$(mktemp -d -t adit-installer)
cleanup() {
  if [[ -e $bin/adit ]]; then
    sudo "$bin/adit" uninstall --yes > /dev/null 2>&1 || true
    sudo rm -f "$bin/adit" "$bin/aditd" "$bin/adit-tray"
  fi
  rm -rf "$work"
}
trap cleanup EXIT

step "a release, built here"
scripts/release-archive "$version" "$work/release"
local_installer "$work/release" "$work/install.sh"

step "a download that does not match SHA256SUMS installs nothing"
mkdir "$work/tampered"
cp "$work/release/adit-macos.tar.gz" "$work/tampered/"
printf '%064d  adit-macos.tar.gz\n' 0 > "$work/tampered/SHA256SUMS"
local_installer "$work/tampered" "$work/install-tampered.sh"
if sh "$work/install-tampered.sh" 2> "$work/tampered.err"; then
  fail "the installer accepted a checksum that does not match"
fi
grep -q "does not match the release's SHA256SUMS\|no checksum for adit-macos.tar.gz" "$work/tampered.err" || fail "unexpected error: $(cat "$work/tampered.err")"
[[ ! -e $bin/adit ]] || fail "$bin/adit was installed anyway"
echo "refused: $(cat "$work/tampered.err")"

step "a Mac where Homebrew installed adit is refused"
mkdir -p "$work/shim" "$work/homebrew/Cellar/adit"
printf '#!/bin/sh\necho %s\n' "$work/homebrew" > "$work/shim/brew"
chmod +x "$work/shim/brew"
if PATH="$work/shim:$PATH" sh "$work/install.sh" 2> "$work/brew.err"; then
  fail "the installer went ahead beside Homebrew's adit"
fi
grep -q "Homebrew installed adit here" "$work/brew.err" || fail "unexpected error: $(cat "$work/brew.err")"
[[ ! -e $bin/adit ]] || fail "$bin/adit was installed anyway"
echo "refused: $(cat "$work/brew.err")"

step "a download cut short runs nothing"
# curl | sh runs what has arrived so far; install.sh does everything from main, called on its last
# line, so any copy cut before that call is complete runs nothing. Cut up to "mai": "main" alone is
# the whole script.
size=$(wc -c < "$work/install.sh" | tr -d ' ')
call=$((size - $(tail -n 1 "$work/install.sh" | wc -c | tr -d ' ')))
[[ $(tail -n 1 docs/install.sh) == 'main "$@"' ]] || fail "install.sh does not end by calling main"
runs=0
for shell in sh bash; do
  for cut in $(seq 1 53 $((call - 1))) $call $((call + 1)) $((call + 2)) $((call + 3)); do
    out=$(head -c "$cut" "$work/install.sh" | "$shell" 2>&1) || true
    if grep -q Downloading <<< "$out" || [[ -e $bin/adit ]]; then
      fail "cut at byte $cut of $size, $shell ran it: $out"
    fi
    runs=$((runs + 1))
  done
done
echo "$runs copies cut short, under sh and bash: none ran anything"

step "install"
sh "$work/install.sh"
for cmd in adit aditd adit-tray; do
  [[ $(stat -f '%Su:%Sg %Lp' "$bin/$cmd") == "root:wheel 755" ]] || fail "$bin/$cmd is not root:wheel 755"
done
sudo launchctl print "system/$label" | grep -q 'state = running' || fail "launchd does not show aditd running"
[[ $("$bin/aditd" -version) == "$version" ]] || fail "aditd is not $version"
"$bin/adit" version | grep -q "adit $version" || fail "adit is not $version"
grep -q "$bin/adit-tray" "/Library/LaunchAgents/$label.tray.plist" || fail "the menu bar icon does not start from $bin"
expect 0 "$bin/adit" list
echo "adit, aditd and adit-tray are root's, in $bin; aditd $version runs; $(id -un) uses adit without sudo"

step "run again, as an upgrade"
sh "$work/install.sh" > /dev/null
sudo launchctl print "system/$label" | grep -q 'state = running' || fail "aditd does not run after the upgrade"
expect 0 "$bin/adit" list

step "remove, as the installer says"
sudo "$bin/adit" uninstall --yes
sudo rm "$bin/adit" "$bin/aditd" "$bin/adit-tray"
for path in "$bin/adit" "$bin/aditd" "$bin/adit-tray" "/Library/LaunchDaemons/$label.plist" \
  "/Library/LaunchAgents/$label.tray.plist" "/Library/PrivilegedHelperTools/$label" /var/db/adit; do
  [[ ! -e $path ]] || fail "$path was left behind"
done
echo "nothing left"

printf '\nPASS\n'
