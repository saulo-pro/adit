#!/usr/bin/env bash
# Stops the test servers and deletes their client files.
set -euo pipefail
cd "$(dirname "$0")"

# Only a process that is still one of these servers: a pid file may outlive its process, and the
# number go to something else.
for pid in out/*.pid; do
  [[ -f $pid ]] || continue
  if ps -p "$(cat "$pid")" -o command= 2> /dev/null | grep -q 'out/wgserver'; then
    kill "$(cat "$pid")" 2> /dev/null || true
  fi
done
# The Docker servers of earlier versions, if any are still running.
if command -v docker > /dev/null; then
  docker rm --force adit-test-1 adit-test-2 > /dev/null 2>&1 || true
fi
rm -rf out
